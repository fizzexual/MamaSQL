# MamaSQL — copy this file to ".env" and edit as needed.
#   cp .env.example .env

# Which published image tag to run ("latest", or a version like "v0.1.0").
MAMASQL_VERSION=latest

# Host port for the web UI (open http://localhost:<WEB_PORT>).
WEB_PORT=5001

# Which host interface the web UI is published on. The default, 127.0.0.1,
# means this machine only. MamaSQL has no login, the bridge behind it will open
# a connection to any host it is given, and the UI is plain http (passwords
# cross the network unencrypted, and the browser can't encrypt saved ones), so
# widen this only on a network you trust:
#   BIND_ADDR=127.0.0.1        # this machine only (from elsewhere: an SSH tunnel)
#   BIND_ADDR=100.x.y.z        # a VPN/Tailscale address only
#   BIND_ADDR=0.0.0.0          # every interface (trusted networks only)
BIND_ADDR=127.0.0.1

# Demo database credentials (used by the bundled postgres/mysql services).
DB_USERNAME=mamasql
DB_PASSWORD=mamasql
DB_DATABASE=demo

# Host ports for the demo databases (only needed for direct/external access).
PG_PORT=5433
MYSQL_PORT=3307

# Which interface those demo-database ports are published on. They use the
# well-known password above, so they default to localhost only. The app itself
# doesn't use these ports — it reaches the databases over the compose network —
# so widen this only to attach an external client from another machine.
DB_BIND_ADDR=127.0.0.1
